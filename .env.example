# Preferred: one URL. Use falkors:// for TLS.
FALKORDB_URL=falkors://default:replace-me@your-instance.example:6379

# Optional fixed graph name. Omit to create a fresh timestamped proof graph.
# FALKORDB_GRAPH=lotline_proof_20261016

# Alternative discrete configuration:
# FALKORDB_HOST=your-instance.example
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=replace-me
# FALKORDB_TLS=true
